# Salin file ini menjadi .env lalu isi nilainya. Jangan pernah commit file .env.

# ---- Database (PostgreSQL, misalnya Supabase) --------------------------------
# Untuk aplikasi: koneksi transaction pooler (Supabase: port 6543)
DATABASE_URL=
# Untuk migrasi dan seed: koneksi session/langsung (Supabase: port 5432)
DIRECT_URL=

# ---- Sesi login petugas ------------------------------------------------------
# String acak minimal 32 karakter. Buat misalnya dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Gunakan nilai berbeda untuk lokal dan produksi.
SESSION_SECRET=

# Password untuk 2 akun demo yang dibuat oleh `npx prisma db seed`
DEMO_PASSWORD=

# ---- AI (API apa pun yang kompatibel dengan OpenAI; bawaan: Groq) -------------
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=openai/gpt-oss-120b
# Dipakai saat model utama kena batas kuota (opsional)
AI_FALLBACK_MODEL=openai/gpt-oss-20b
# low | medium | high, untuk model yang bernalar (opsional)
AI_REASONING_EFFORT=low
# true = kalimat jawaban ditulis ulang oleh AI (dijaga pemeriksa angka). Bawaan: false
AI_REWRITE=false

# ---- Cloudflare Turnstile (opsional; kosong = form aspirasi tanpa anti-bot) ----
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
